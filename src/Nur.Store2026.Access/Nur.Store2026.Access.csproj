<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>joseco</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/nur-university/sk2024-store-access</RepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nur.Store2025.Access.Catalog" Version="1.0.0" Condition="!Exists('$(MSBuildThisFileDirectory)..\Nur.Store2026.Access.Catalog\Nur.Store2026.Access.Catalog.csproj')" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Nur.Store2026.Access.Catalog\Nur.Store2026.Access.Catalog.csproj" Condition="Exists('$(MSBuildThisFileDirectory)..\Nur.Store2026.Access.Catalog\Nur.Store2026.Access.Catalog.csproj')" />
    <PackageReference Include="Nur.Store2025.Access.Identity" Version="1.0.0" Condition="!Exists('$(MSBuildThisFileDirectory)..\Nur.Store2026.Access.Identity\Nur.Store2026.Access.Identity.csproj')" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Nur.Store2026.Access.Identity\Nur.Store2026.Access.Identity.csproj" Condition="Exists('$(MSBuildThisFileDirectory)..\Nur.Store2026.Access.Identity\Nur.Store2026.Access.Identity.csproj')" />
    <PackageReference Include="Nur.Store2025.Access.Inventory" Version="1.0.0" Condition="!Exists('$(MSBuildThisFileDirectory)..\Nur.Store2026.Access.Inventory\Nur.Store2026.Access.Inventory.csproj')" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Nur.Store2026.Access.Inventory\Nur.Store2026.Access.Inventory.csproj" Condition="Exists('$(MSBuildThisFileDirectory)..\Nur.Store2026.Access.Inventory\Nur.Store2026.Access.Inventory.csproj')" />
  </ItemGroup>

</Project>
